#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "$0")/.." && pwd)
INSTALL_SH="$ROOT/install.sh"
RB_SRC="$ROOT/bin/rb"
pass=0
fail=0

fail_msg() {
  printf 'FAIL %s\n' "$*" >&2
  if [[ -n "${STDOUT:-}" ]]; then
    printf 'stdout:\n%s\n' "$STDOUT" >&2
  fi
  if [[ -n "${STDERR:-}" ]]; then
    printf 'stderr:\n%s\n' "$STDERR" >&2
  fi
  fail=$((fail + 1))
}

pass_msg() {
  pass=$((pass + 1))
}

run_capture() {
  local status
  STDOUT=""
  STDERR=""
  set +e
  STDOUT=$( "$@" 2>"$WORK/stderr" )
  status=$?
  set -e
  STDERR=$(cat "$WORK/stderr")
  return "$status"
}

source_install() {
  local body=$1
  INSTALL_SH="$INSTALL_SH" bash -c 'set -euo pipefail; source "$INSTALL_SH"; '"$body"
}

assert_success() {
  local desc=$1
  shift
  if run_capture "$@"; then
    pass_msg
  else
    fail_msg "$desc (exit $?)"
  fi
}

assert_failure() {
  local desc=$1
  shift
  if run_capture "$@"; then
    fail_msg "$desc (expected failure)"
  else
    pass_msg
  fi
}

assert_eq() {
  local desc=$1
  local got=$2
  local expected=$3
  if [[ $got == "$expected" ]]; then
    pass_msg
  else
    STDOUT=$got
    STDERR="expected: $expected"
    fail_msg "$desc"
  fi
}

assert_contains() {
  local desc=$1
  local haystack=$2
  local needle=$3
  if [[ $haystack == *"$needle"* ]]; then
    pass_msg
  else
    STDOUT=$haystack
    STDERR="missing: $needle"
    fail_msg "$desc"
  fi
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
export HOME="$WORK/home"
mkdir -p "$HOME"
: >"$HOME/.bashrc"

assert_success "bash -n install.sh" bash -n "$INSTALL_SH"
assert_success "bash -n bin/rb" bash -n "$RB_SRC"
assert_success "bash -n bashrc" bash -n "$ROOT/bashrc"
assert_success "bash -n init.bash" bash -n "$ROOT/init.bash"
assert_success "bash -n plugins/git/plugin.bash" bash -n "$ROOT/plugins/git/plugin.bash"
assert_success "bash -n tests/run" bash -n "$ROOT/tests/run"

assert_success "install.sh --help" "$INSTALL_SH" --help
assert_contains "help mentions --prefix" "$STDOUT" "--prefix"
assert_contains "help mentions --uninstall" "$STDOUT" "--uninstall"
assert_contains "help mentions rb" "$STDOUT" "rb"

assert_failure "unknown option" "$INSTALL_SH" --nope

help_pipe_status=0
set +e
STDOUT=$(bash -s -- --help <"$INSTALL_SH")
help_pipe_status=$?
set -e
if [[ $help_pipe_status -eq 0 && $STDOUT == *"--prefix"* ]]; then
  pass_msg
else
  fail_msg "piped --help"
fi

if run_capture source_install 'destination_path /usr/local/'; then
  assert_eq "destination_path" "$STDOUT" "/usr/local/bin/rb"
else
  fail_msg "destination_path"
fi

if run_capture source_install 'destination_path /usr/local'; then
  assert_eq "destination_path without trailing slash" "$STDOUT" "/usr/local/bin/rb"
else
  fail_msg "destination_path without trailing slash"
fi

if run_capture source_install 'data_path /usr/local/'; then
  assert_eq "data_path" "$STDOUT" "/usr/local/share/rebash"
else
  fail_msg "data_path"
fi

if run_capture source_install '
  unset PREFIX ACTION
  HOME=/tmp/rebash-home
  parse_args
  printf "%s %s\n" "$ACTION" "$PREFIX"
'; then
  assert_eq "parse_args defaults" "$STDOUT" "install /tmp/rebash-home/.local"
else
  fail_msg "parse_args defaults"
fi

if run_capture source_install '
  parse_args --prefix /usr/local
  printf "%s %s\n" "$ACTION" "$PREFIX"
'; then
  assert_eq "parse_args --prefix" "$STDOUT" "install /usr/local"
else
  fail_msg "parse_args --prefix"
fi

if run_capture source_install '
  parse_args --uninstall --prefix /opt
  printf "%s %s\n" "$ACTION" "$PREFIX"
'; then
  assert_eq "parse_args --uninstall" "$STDOUT" "uninstall /opt"
else
  fail_msg "parse_args --uninstall"
fi

if run_capture source_install '
  parse_args --update --channel alpha --prefix /opt
  printf "%s %s %s\n" "$ACTION" "$PREFIX" "$CHANNEL"
'; then
  assert_eq "parse_args --update --channel" "$STDOUT" "update /opt alpha"
else
  fail_msg "parse_args --update --channel"
fi

prefix="$WORK/local"
assert_success "install to prefix" "$INSTALL_SH" --prefix "$prefix"
assert_success "wrapper exists" test -x "$prefix/bin/rb"
assert_success "staged rb exists" test -x "$prefix/share/rebash/bin/rb"
assert_success "bashrc staged" test -f "$prefix/share/rebash/bashrc"
assert_success "install.sh staged" test -x "$prefix/share/rebash/install.sh"
assert_success "init.bash staged" test -f "$prefix/share/rebash/init.bash"
assert_eq "installed channel is main" "$(cat "$prefix/share/rebash/CHANNEL")" "main"
assert_contains "bashrc hook installed" "$(cat "$HOME/.bashrc")" ">>> rebash >>>"
assert_contains "bashrc hook sources init" "$(cat "$HOME/.bashrc")" "init.bash"

got=$(PATH="$prefix/bin" command -v rb)
assert_eq "rb is on PATH" "$got" "$prefix/bin/rb"

assert_success "installed rb --help" "$prefix/bin/rb" --help
assert_contains "installed help mentions bash" "$STDOUT" "bash"
assert_contains "installed help mentions up" "$STDOUT" "rb up"
assert_contains "installed help mentions update" "$STDOUT" "rb update"

assert_success "installed rb --version" "$prefix/bin/rb" --version
assert_contains "version starts with rebash" "$STDOUT" "rebash"
assert_contains "version mentions main" "$STDOUT" "(main)"

got=$(PATH="$prefix/bin:$PATH" rb -c 'printf %s "$REBASH"')
assert_eq "rb -c sees REBASH" "$got" "1"

got=$(PATH="$prefix/bin:$PATH" rb -c 'printf %s "$REBASH_ROOT"')
assert_eq "rb -c sees REBASH_ROOT" "$got" "$prefix/share/rebash"

assert_success "git plugin is staged" test -f "$prefix/share/rebash/plugins/git/plugin.bash"

test_home="$WORK/home"
mkdir -p "$test_home"
rb() {
  env HOME="$test_home" XDG_CONFIG_HOME="$test_home/.config" PATH="$prefix/bin:$PATH" "$prefix/bin/rb" "$@"
}

assert_failure "gs alias absent before up" rb -c 'alias gs'
assert_failure "rb up without a name" rb up
assert_contains "up usage mentions git" "$STDERR$STDOUT" "git"
assert_failure "rb up unknown plugin" rb up nope
assert_failure "rb up path traversal" rb up '../git'
assert_failure "rb up extra args" rb up git extra

assert_success "rb up git" rb up git
assert_eq "up git message" "$STDOUT" "up git"
assert_success "enabled list exists" test -f "$test_home/.config/rebash/plugins"
assert_eq "enabled list is git" "$(cat "$test_home/.config/rebash/plugins")" "git"

assert_success "rb up git is idempotent" rb up git
assert_eq "idempotent up git message" "$STDOUT" "up git"
assert_eq "enabled list has one line" "$(grep -c '^git$' "$test_home/.config/rebash/plugins")" "1"

assert_success "gs alias after up" rb -c 'alias gs'
assert_contains "gs is git status" "$STDOUT" "git status"
assert_success "g alias after up" rb -c 'alias g'
assert_contains "g is git" "$STDOUT" "alias g='git'"
assert_success "gco alias after up" rb -c 'alias gco'
assert_contains "gco is git checkout" "$STDOUT" "git checkout"

if run_capture env HOME="$test_home" XDG_CONFIG_HOME="$test_home/.config" \
  bash -c 'source "$1"; alias gs' x "$prefix/share/rebash/init.bash"; then
  assert_contains "init.bash loads gs" "$STDOUT" "git status"
else
  fail_msg "init.bash loads gs"
fi

if run_capture env HOME="$test_home" XDG_CONFIG_HOME="$test_home/.config" \
  bash -c '
    cd() { printf "hook %s\n" "$PWD"; builtin cd "$@"; }
    pwd() { printf "hook %s\n" "$PWD"; }
    source "$1"
    printf "%s\n" "$REBASH_ROOT"
  ' x "$prefix/share/rebash/init.bash"; then
  assert_eq "init.bash ignores cd/pwd wrappers" "$STDOUT" "$prefix/share/rebash"
else
  fail_msg "init.bash ignores cd/pwd wrappers"
fi

unset -f rb

assert_success "reinstall overwrites" "$INSTALL_SH" --prefix "$prefix"

assert_success "uninstall" "$INSTALL_SH" --uninstall --prefix "$prefix"
assert_success "wrapper removed" test ! -e "$prefix/bin/rb"
assert_success "data dir removed" test ! -e "$prefix/share/rebash"
if grep -qF '>>> rebash >>>' "$HOME/.bashrc"; then
  fail_msg "bashrc hook removed on uninstall"
else
  pass_msg
fi

fixture="$WORK/fixture"
mkdir -p "$fixture/bin"
cp "$RB_SRC" "$fixture/bin/rb"
cp "$ROOT/bashrc" "$fixture/bashrc"
chmod +x "$fixture/bin/rb"
git -C "$fixture" init -q -b main
git -C "$fixture" add bin/rb bashrc
git -C "$fixture" \
  -c user.name=rebash \
  -c user.email=rebash@example.test \
  commit -q -m "fixture"

piped_home="$WORK/piped-home"
mkdir -p "$piped_home"
: >"$piped_home/.bashrc"
piped_prefix="$piped_home/.local"
set +e
STDOUT=$(
  HOME="$piped_home" \
    XDG_CACHE_HOME="$piped_home/.cache" \
    REBASH_REPO="$fixture" \
    bash -s -- --prefix "$piped_prefix" <"$INSTALL_SH"
)
piped_status=$?
set -e
if [[ $piped_status -eq 0 && -x $piped_prefix/bin/rb ]]; then
  pass_msg
else
  fail_msg "piped install from REBASH_REPO"
fi

got=$(PATH="$piped_prefix/bin" command -v rb)
assert_eq "piped install puts rb on PATH" "$got" "$piped_prefix/bin/rb"
assert_success "piped install cache stays under test HOME" test -d "$piped_home/.cache/rebash/src"

git_commit() {
  local repo=$1
  local message=$2
  git -C "$repo" \
    -c user.name=rebash \
    -c user.email=rebash@example.test \
    commit -q -m "$message"
}

update_repo="$WORK/update-repo"
mkdir -p "$update_repo/bin" "$update_repo/plugins/git"
cp "$INSTALL_SH" "$update_repo/install.sh"
cp "$RB_SRC" "$update_repo/bin/rb"
cp "$ROOT/bashrc" "$update_repo/bashrc"
cp "$ROOT/init.bash" "$update_repo/init.bash"
cp "$ROOT/plugins/git/plugin.bash" "$update_repo/plugins/git/plugin.bash"
chmod +x "$update_repo/install.sh" "$update_repo/bin/rb"
git -C "$update_repo" init -q -b main
git -C "$update_repo" add install.sh bin bashrc init.bash plugins
git_commit "$update_repo" "main"
git -C "$update_repo" checkout -q -b alpha
printf 'alpha-marker\n' >"$update_repo/plugins/git/alpha"
git -C "$update_repo" add plugins/git/alpha
git_commit "$update_repo" "alpha"
git -C "$update_repo" checkout -q main

update_home="$WORK/update-home"
mkdir -p "$update_home"
: >"$update_home/.bashrc"
update_prefix="$update_home/.local"
set +e
STDOUT=$(
  HOME="$update_home" \
    XDG_CACHE_HOME="$update_home/.cache" \
    REBASH_REPO="$update_repo" \
    bash -s -- --prefix "$update_prefix" <"$INSTALL_SH"
)
update_install_status=$?
set -e
if [[ $update_install_status -eq 0 && -x $update_prefix/bin/rb ]]; then
  pass_msg
else
  fail_msg "channel fixture install"
fi

assert_eq "fixture channel is main" "$(cat "$update_prefix/share/rebash/CHANNEL")" "main"
assert_success "alpha marker absent on main" test ! -e "$update_prefix/share/rebash/plugins/git/alpha"

rb_update() {
  env HOME="$update_home" \
    XDG_CACHE_HOME="$update_home/.cache" \
    PATH="$update_prefix/bin:$PATH" \
    "$update_prefix/bin/rb" "$@"
}

assert_failure "rb update extra args" rb_update update main extra
assert_failure "rb update invalid channel" rb_update update '../main'
assert_failure "rb update missing channel" rb_update update nosuch

assert_success "rb update alpha" rb_update update alpha
assert_contains "update alpha message" "$STDOUT" "updated alpha"
assert_eq "channel file is alpha" "$(cat "$update_prefix/share/rebash/CHANNEL")" "alpha"
assert_success "alpha marker present" test -f "$update_prefix/share/rebash/plugins/git/alpha"
assert_success "version on alpha" rb_update --version
assert_contains "version mentions alpha" "$STDOUT" "(alpha)"

printf 'alpha-again\n' >"$update_repo/plugins/git/alpha2"
git -C "$update_repo" checkout -q alpha
git -C "$update_repo" add plugins/git/alpha2
git_commit "$update_repo" "alpha 2"
git -C "$update_repo" checkout -q main

assert_success "rb update current channel" rb_update update
assert_contains "update keeps alpha" "$STDOUT" "updated alpha"
assert_success "second alpha marker present" test -f "$update_prefix/share/rebash/plugins/git/alpha2"

assert_success "rb update main" rb_update update main
assert_eq "channel file is main again" "$(cat "$update_prefix/share/rebash/CHANNEL")" "main"
assert_success "alpha marker gone on main" test ! -e "$update_prefix/share/rebash/plugins/git/alpha"

unset -f rb_update git_commit

printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ $fail -ne 0 ]]; then
  exit 1
fi
