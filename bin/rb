#!/usr/bin/env bash
set -euo pipefail

SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
ROOT=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd)

die() {
  printf 'rb: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: rb [bash-args...]
       rb up <plugin>
       rb update [channel]
       rb --help
       rb --version

Start bash with rebash loaded. Extra arguments go to bash.

  up <plugin>        Enable a plugin, for example: rb up git
  update [channel]   Pull the latest of a channel (default: current, or main)
EOF
}

version() {
  local rev="" channel=""
  if [[ -r "$ROOT/REVISION" ]]; then
    rev=$(<"$ROOT/REVISION")
    rev=${rev%%$'\n'*}
  fi
  if [[ -r "$ROOT/CHANNEL" ]]; then
    channel=$(<"$ROOT/CHANNEL")
    channel=${channel%%$'\n'*}
  fi
  if [[ -n $rev && -n $channel ]]; then
    printf 'rebash %s (%s)\n' "$rev" "$channel"
  elif [[ -n $rev ]]; then
    printf 'rebash %s\n' "$rev"
  elif [[ -n $channel ]]; then
    printf 'rebash (%s)\n' "$channel"
  else
    printf 'rebash\n'
  fi
}

valid_channel_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

infer_prefix() {
  local share
  share=$(dirname -- "$ROOT")
  [[ $(basename -- "$share") == share ]] || return 1
  [[ $(basename -- "$ROOT") == rebash ]] || return 1
  dirname -- "$share"
}

update_usage() {
  cat <<'EOF'
Usage: rb update [channel]

Pull the latest revision of a channel. With no channel, uses the one
already installed, or main.
EOF
}

cmd_update() {
  case "${1:-}" in
    -h | --help)
      update_usage
      exit 0
      ;;
  esac
  if [[ $# -gt 1 ]]; then
    die "update takes an optional channel"
  fi

  local prefix installer tmp status
  if [[ $# -eq 1 ]]; then
    valid_channel_name "$1" || die "invalid channel: ${1}"
  fi
  prefix=$(infer_prefix) || die "cannot determine install prefix from ${ROOT}"
  installer="$ROOT/install.sh"
  [[ -f "$installer" ]] || die "missing ${installer}; reinstall with install.sh"

  tmp=$(mktemp)
  cp "$installer" "$tmp"
  set +e
  if [[ $# -eq 1 ]]; then
    bash "$tmp" --prefix "$prefix" --channel "$1" --update
  else
    bash "$tmp" --prefix "$prefix" --update
  fi
  status=$?
  set -e
  rm -f "$tmp"
  exit "$status"
}

valid_plugin_name() {
  [[ $1 =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]
}

plugin_file() {
  printf '%s\n' "$ROOT/plugins/$1/plugin.bash"
}

enabled_file() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/rebash/plugins"
}

plugin_is_enabled() {
  local name=$1 file line
  file=$(enabled_file)
  [[ -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == "$name" ]] && return 0
  done <"$file"
  return 1
}

list_available_plugins() {
  local dir f name
  dir="$ROOT/plugins"
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*/plugin.bash; do
    [[ -f "$f" ]] || continue
    name=${f%/*}
    name=${name##*/}
    printf '%s\n' "$name"
  done | sort
}

up_usage() {
  cat <<'EOF'
Usage: rb up <plugin>
EOF
  local available
  available=$(list_available_plugins)
  if [[ -n $available ]]; then
    printf '\nPlugins:\n'
    printf '%s\n' "$available" | sed 's/^/  /'
  fi
}

cmd_up() {
  if [[ $# -eq 0 ]]; then
    up_usage >&2
    exit 1
  fi
  if [[ $# -ne 1 ]]; then
    die "up takes one plugin name"
  fi

  local name=$1 file dest dir
  valid_plugin_name "$name" || die "invalid plugin name: ${name}"
  file=$(plugin_file "$name")
  [[ -f "$file" ]] || die "plugin not found: ${name}"

  dest=$(enabled_file)
  if plugin_is_enabled "$name"; then
    printf 'up %s\n' "$name"
  else
    dir=$(dirname -- "$dest")
    mkdir -p "$dir"
    printf '%s\n' "$name" >>"$dest"
    printf 'up %s\n' "$name"
  fi
  if [[ ${REBASH_INIT:-0} != 1 ]]; then
    printf 'rb: source %s to load plugins in this shell\n' "$ROOT/init.bash" >&2
  fi
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --version)
    version
    exit 0
    ;;
  up)
    shift
    cmd_up "$@"
    exit 0
    ;;
  update)
    shift
    cmd_update "$@"
    exit 0
    ;;
esac

if [[ ! -f "$ROOT/bashrc" ]]; then
  printf 'rb: missing %s\n' "$ROOT/bashrc" >&2
  exit 1
fi

export REBASH_ROOT=$ROOT
export BASH_ENV=$ROOT/bashrc
exec bash --rcfile "$ROOT/bashrc" "$@"
